# LLM-Provider API keys
OPENAI_API_KEY          =
GOOGLE_API_KEY          =
MISTRAL_API_KEY         =
ANTHROPIC_API_KEY       =

# Local LlamaCpp model (optional -- points at an already-downloaded GGUF
# file so LlamaCppEngine skips Hugging Face resolution entirely; leave
# blank to fall back to each example's repo_id/filename download)
LLAMA_MODEL_PATH        =

# Litellm proxy
LITELLM_MASTER_KEY      =

# Web-Researching API
TAVILY_API_KEY          =

# Pytest Integration Switch (0 to skip, 1 to run)
AA_RUN_LIVE_LLM_TESTS   = 0
